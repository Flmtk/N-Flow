# N-Flow · Vorlage für die .env auf dem Server
# Kopieren nach .env und ausfüllen. Die .env niemals ins Repository einchecken.

# Umgebung: test oder live (bestimmt auch die Namen in Docker und Traefik)
INSTANZ=test
DOMAIN=test.novis-anlagentechnik.de
BASE_URL=https://test.novis-anlagentechnik.de

# Datenbank-Passwort – erzeugen mit:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Signiert die Anmelde-Cookies – erzeugen mit:  openssl rand -hex 32
SESSION_SECRET=

# Microsoft Entra ID (siehe docs/entra-app.md)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Absender (Postfächer in Microsoft 365, siehe docs/entra-app.md)
# info@: Terminbestätigungen und interne Hinweise · rechnung@: Rechnungen und Mahnungen
MAIL_VON_INFO=info@novis-anlagentechnik.de
MAIL_VON_RECHNUNG=rechnung@novis-anlagentechnik.de
# Empfänger für Nachbestellungen aus dem Fahrzeuglager und die Meldung überfälliger Rechnungen
MAIL_EINKAUF=einkauf@novis-anlagentechnik.de
MAIL_RECHNUNG=rechnung@novis-anlagentechnik.de

# Ablage in SharePoint (siehe docs/sharepoint.md), Adresse der Website ohne / am Ende
SHAREPOINT_SEITE=

# Diese Adressen werden beim ersten Anmelden automatisch als Geschäftsführung angelegt
ADMIN_EMAILS=vorname.nachname@novis-anlagentechnik.de,zweite.adresse@novis-anlagentechnik.de

# Anmeldung bleibt so viele Tage bestehen
SESSION_DAYS=30
# Jeden Montag 0:00 Uhr neu anmelden (0 = aus)
ANMELDUNG_WOECHENTLICH=1

# Sicherung
SICHERUNG_UHRZEIT=02:00
SICHERUNG_ORDNER=./sicherungen
